# MOVIPA Frontend Environment Configuration
# 
# Copy this file to .env.local and fill in your own values
# NEVER commit .env.local to version control
# 
# Example values shown below - replace with your configuration

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
REACT_APP_WC_PROJECT_ID=your_walletconnect_project_id_here

# Blockchain Configuration
REACT_APP_CHAIN_ID=11155111
REACT_APP_CHAIN_NAME=sepolia

# API Configuration
# In production, point to your backend API
# REACT_APP_API_URL=https://api.example.com
# REACT_APP_API_URL=http://localhost:8001  (for local development)

# RPC Endpoints (Optional - if using direct RPC calls)
# REACT_APP_RPC_URL_ETHEREUM=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# REACT_APP_RPC_URL_BASE=https://base-sepolia-rpc.publicnode.com
# REACT_APP_RPC_URL_ARBITRUM=https://arbitrum-sepolia-rpc.publicnode.com

# Optional: Sentry for error tracking
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Analytics
# REACT_APP_GA_ID=G-YOUR_GOOGLE_ANALYTICS_ID

# Optional: Feature Flags
# REACT_APP_ENABLE_EXPERIMENTAL_FEATURES=false

# Environment
REACT_APP_ENVIRONMENT=development
